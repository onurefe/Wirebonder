{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cortex debug",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "build/firmware",
            "svdFile": ".vscode/STM32F446.svd",
            "toolchainPrefix": "arm-none-eabi",
            "armToolchainPath": "/Users/ruya/STM32Toolchain/gcc-arm/bin",
            "configFiles": [
                "/opt/homebrew/share/openocd/scripts/interface/stlink.cfg",
                ".vscode/stm32f4x.cfg"
            ],
            "preLaunchTask": "Build project"
        },
        {
            "name": "Debug current Python file",
            "type": "python",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ]
}